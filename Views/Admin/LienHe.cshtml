@model List<QuanCafe.Models.LienHe>
@{
    ViewData["Title"] = "Tin nhắn liên hệ";
}

<div class="container py-4">
    <h1 class="mb-4">Tin Nhắn Liên Hệ</h1>

    @if(Model.Count == 0)
    {
        <p class="text-muted">chưa có tin nhắn nào.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Ngày gửi</th>
                    <th>Họ Tên</th>
                    <th>Số Điện thoại</th>
                    <th>Nội dung</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model){
                    <tr>
                        <td>@l.NgayGui.ToString("dd/mm/yyyy HH:mm")</td>
                        <td>@l.HoTen</td>
                        <td>@l.SoDienThoai</td>
                        <td>@l.NoiDung</td>
                        <td>
                            <form asp-action="XoaLienHe" asp-route-id="@l.Id" method="post"
                                onsubmit="return confirm('Xóa Tin Nhắn này?');">
                                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>